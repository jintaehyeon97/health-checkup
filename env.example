# 이 파일을 .env 로 복사한 뒤 비밀번호를 직접 입력하세요. (.env 는 커밋 금지)
# 8자 이상, 대문자·소문자·숫자·기호 중 3종류 이상 포함해야 SQL Server가 시작됩니다.
MSSQL_SA_PASSWORD=


# --- AI 자연어 질의(app/) 용 설정 ---
# SQL Server(Docker, 포트 14330) 읽기 전용 계정(ai_reader)으로 연결합니다. 비밀번호는 .env 에만 직접 입력하세요.
DB_URI=mssql+pyodbc://ai_reader:비밀번호@localhost:14330/healthdb_restore?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# 질의에 노출할 테이블(쉼표로 구분)
DB_TABLES=fact_checkup
# 사용할 LLM (예: anthropic:모델이름 / openai:모델이름) 과 해당 서비스의 API 키
LLM_MODEL=
# ANTHROPIC_API_KEY=   또는   OPENAI_API_KEY=
